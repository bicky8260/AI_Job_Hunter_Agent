# ============================================================
# AI Job Hunter Agent — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git
# ============================================================

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://jobhunter:jobhunter@localhost:5432/jobhunter
# For Docker Compose, use: postgresql+asyncpg://jobhunter:jobhunter@postgres:5432/jobhunter

# ----------------------------------------------------------
# Email Configuration
# For Gmail: use an App Password (not your real password)
# Enable 2FA on Gmail → Security → App Passwords → Create
# ----------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=biswajitmishra545@gmail.com
EMAIL_PASSWORD=           # ← REPLACE with Gmail App Password (Google Account → Security → App Passwords)
EMAIL_FROM=biswajitmishra545@gmail.com
EMAIL_TO=biswajitmishra545@gmail.com
EMAIL_RECIPIENT_NAME=Biswa

# ----------------------------------------------------------
# LLM Provider — Required for AI matching
# Choose: gemini | openai | mock
# "mock" works without any API key (rule-based scoring)
# ----------------------------------------------------------
LLM_PROVIDER=gemini

# Google Gemini (recommended — free tier available)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyDPUV_wOT-EcFK8uXsBIOeSq2fHal1wDRk
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (optional fallback)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# Job Source API Keys (all optional — app works without them)
# ----------------------------------------------------------

# Adzuna — Free: https://developer.adzuna.com/
# Great for India DevOps jobs
ADZUNA_APP_ID=2ace800f
ADZUNA_APP_KEY=7e26fe9ac74513c5cbcc1157d0346b0c

# Jooble — Free: https://jooble.org/api/about
# Good India coverage
JOOBLE_API_KEY=49a85b78-53a5-4896-b9de-e9b6ba6cd36f

# SerpAPI — Paid: https://serpapi.com/
# Used for discovering LinkedIn job URLs via Google search
# Without this, LinkedIn URLs will not be surfaced
SERPAPI_KEY=

# ----------------------------------------------------------
# Application Settings
# ----------------------------------------------------------
SECRET_KEY=5889a85364a29e828142e5f4bedd32b7965e4a54859f909de8e6208672f49a24
DEBUG=false
LOG_LEVEL=INFO

# Scheduler settings (24-hour format, IST by default)
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_HOUR=9
SCHEDULER_MINUTE=0

# Minimum match score to include in email (0-100)
MIN_MATCH_SCORE=70

# Send email even when no jobs found? (false recommended)
SEND_EMPTY_EMAIL=false

# ----------------------------------------------------------
# File Paths
# ----------------------------------------------------------
UPLOAD_DIR=uploads
RESUME_FILENAME=resume.pdf
